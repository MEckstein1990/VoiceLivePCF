<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="KoRaVoiceControl" constructor="VoiceLiveControl" version="1.29.0" display-name-key="VoiceLiveChat" description-key="VoiceLiveChat_Desc" control-type="standard">
    <external-service-usage enabled="true">
      <domain>*.services.ai.azure.com</domain>
      <domain>*.cognitiveservices.azure.com</domain>
      <domain>*.azurewebsites.net</domain>
      <domain>login.microsoftonline.com</domain>
    </external-service-usage>
    
    <property name="AgentId" display-name-key="AgentId_Display" description-key="AgentId_Desc" of-type="SingleLine.Text" usage="input" required="true" />
    <property name="AgentProjectName" display-name-key="AgentProjectName_Display" description-key="AgentProjectName_Desc" of-type="SingleLine.Text" usage="input" required="true" />
    <property name="AgentEndpoint" display-name-key="AgentEndpoint_Display" description-key="AgentEndpoint_Desc" of-type="SingleLine.Text" usage="input" required="true" />
    <property name="TokenEndpoint" display-name-key="TokenEndpoint_Display" description-key="TokenEndpoint_Desc" of-type="SingleLine.Text" usage="input" required="true" />
    
    <property name="UserId" display-name-key="UserId_Display" description-key="UserId_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="UserName" display-name-key="UserName_Display" description-key="UserName_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="ProxyKey" display-name-key="ProxyKey_Display" description-key="ProxyKey_Desc" of-type="SingleLine.Text" usage="input" required="true" />
    <property name="MsalClientId" display-name-key="MsalClientId_Display" description-key="MsalClientId_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="TenantId" display-name-key="TenantId_Display" description-key="TenantId_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="DataverseOrgUrl" display-name-key="DataverseOrgUrl_Display" description-key="DataverseOrgUrl_Desc" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="Connected" display-name-key="Connected_Display" description-key="Connected_Desc" of-type="TwoOptions" usage="bound" required="false" />
    
    <property name="AgentVoice" display-name-key="AgentVoice_Display" description-key="AgentVoice_Desc" of-type="Enum" usage="input" required="true">
      <value name="de-DE-Florian:DragonHDLatestNeural" display-name-key="AgentVoice_Florian">de-DE-Florian:DragonHDLatestNeural</value>
      <value name="de-DE-KatjaNeural" display-name-key="AgentVoice_Katja">de-DE-KatjaNeural</value>
      <value name="de-DE-Seraphina:DragonHDLatestNeural" display-name-key="AgentVoice_Seraphina">de-DE-Seraphina:DragonHDLatestNeural</value>
      <value name="de-DE-ConradNeural" display-name-key="AgentVoice_Conrad">de-DE-ConradNeural</value>
    </property>
    <property name="AgentLanguage" display-name-key="AgentLanguage_Display" description-key="AgentLanguage_Desc" of-type="Enum" usage="input" required="true">
      <value name="de" display-name-key="Lang_DE">de</value>
      <value name="en" display-name-key="Lang_EN">en</value>
      <value name="fr" display-name-key="Lang_FR">fr</value>
    </property>
    <property name="VoiceSpeed" display-name-key="VoiceSpeed_Display" description-key="VoiceSpeed_Desc" of-type="Enum" usage="input" required="true">
      <value name="0.9" display-name-key="VoiceSpeed_Langsam">langsam</value>
      <value name="1.0" display-name-key="VoiceSpeed_Mittel">mittel</value>
      <value name="1.1" display-name-key="VoiceSpeed_Schnell">schnell</value>
      <value name="1.3" display-name-key="VoiceSpeed_SehrSchnell">sehr schnell</value>
    </property>
    <property name="SilenceDurationMs" display-name-key="SilenceDurationMs_Display" description-key="SilenceDurationMs_Desc" of-type="Whole.None" usage="input" required="true" default-value="1500" />
    <property name="VadThreshold" display-name-key="VadThreshold_Display" description-key="VadThreshold_Desc" of-type="FP" usage="input" required="true" default-value="0.5" />

    <property name="ConnectionStatus" display-name-key="VLC_ConnectionStatus_Display" description-key="VLC_ConnectionStatus_Desc" of-type="SingleLine.Text" usage="output" />
    <property name="Transcript" display-name-key="VLC_Transcript_Display" description-key="VLC_Transcript_Desc" of-type="Multiple" usage="output" />
    <property name="EventLog" display-name-key="EventLog_Display" description-key="EventLog_Desc" of-type="Multiple" usage="output" />
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/AiVoiceControl.css" order="1" />
      <resx path="strings/VoiceLiveControl.1033.resx" version="1.0.0" />
    </resources>
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="false" />
    </feature-usage>
  </control>
</manifest>
